# 上架签名配置模板
#
# 用法：
#   1. 复制本文件为 keystore.properties（该文件已被 .gitignore 排除，不会入库）
#   2. 生成密钥库：
#        keytool -genkeypair -v -keystore billpic-release.jks \
#          -alias billpic -keyalg RSA -keysize 2048 -validity 10000
#   3. 把密钥库放到仓库根目录（或填写绝对路径），并填写下面的四项
#
# 注意：keystore.properties 不存在时，release 会自动回退到 debug 签名，
# 这样任何一台机器都能编译出包（仅用于内部走查，不可用于分发）。

storeFile=billpic-release.jks
storePassword=在此填写密钥库口令
keyAlias=billpic
keyPassword=在此填写密钥口令
