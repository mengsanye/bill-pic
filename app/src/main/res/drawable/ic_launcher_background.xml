<?xml version="1.0" encoding="utf-8"?>
<!--
  BillPic 自适应图标 · 背景层
  ─────────────────────────────────────────────────────────────
  45° 线性渐变，保证任意蒙版（圆形 / 超椭圆 / 圆角方形 / 厂商自有形状）
  下都铺满画布，不留白边。渐变同时充当"打光"，让前景的白纸浮起来。

  色彩令牌：与 design/icon/generate_icons.py 的 GRAD_TOP / GRAD_BOTTOM 一致。
  #2E93FF（亮）→ #0057CC（深），中点 ≈ 品牌蓝 #007AFF。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:color="#FF2E93FF"
                    android:offset="0.0" />
                <item
                    android:color="#FF0057CC"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
