<!--
  BillPic 自适应图标 · 前景层
  ─────────────────────────────────────────────────────────────
  设计概念「一页 PDF，出来一张图」：
    白色纸张（右上折角 + 三条文字条）＝ PDF 文档，占画面主导；
    右下角滑出的一块带白边的照片＝转换出来的图片，内容是缩小的景物。

  为什么不是「纸里放一张全幅风景」：那正是相册 / 图库 App 的构图
  （白底 + 满幅风景），桌面上会被直接归到「图库」那一类。
  这里让风景**只出现在一张小照片的内部**——照片是产物、纸是主体，
  读法就变成「文档 → 出一张图」。

    ⚠ 本文件是图标几何的**唯一真相源**。mipmap 下的 webp 位图由这里的坐标导出，
      改了几何必须同步重新导出，否则矢量与位图走形。

  几何（dp，108 画布 / 中心 54,54）：
    纸张      (32.5,29.5)-(64.5,74.5)  圆角 3.2  折角 10.0  比例 0.711 ≈ A4(0.707)
    文字条    3 条，x 起 36.5，高 1.7
    照片块    (44.5,52.5)-(69.5,77.5)  圆角 5.8，白框 2.0，白卡纸 1.6
    安全区    全部前景顶点最远 31.28 dp < 33 dp（66dp 安全圆）
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 折角纸片：位于被切掉的角上，纸张随后覆盖，交界处自然形成折线 -->
    <path
        android:fillColor="#FFD8E7FF"
        android:pathData="M54.5,29.5 H61.3 A3.2,3.2 0 0 1 64.5,32.7 L64.5,39.5 Z" />

    <!-- 纸张 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M35.7,29.5 H54.5 L64.5,39.5 V71.3 A3.2,3.2 0 0 1 61.3,74.5 H35.7 A3.2,3.2 0 0 1 32.5,71.3 V32.7 A3.2,3.2 0 0 1 35.7,29.5 Z" />

    <!-- 页内文字条（示意原 PDF 的文字内容，弱化处理） -->
    <path
        android:fillColor="#FFA9CCFF"
        android:pathData="M37.35,37.5 H59.65 A0.85,0.85 0 0 1 60.5,38.35 A0.85,0.85 0 0 1 59.65,39.2 H37.35 A0.85,0.85 0 0 1 36.5,38.35 A0.85,0.85 0 0 1 37.35,37.5 Z" />
    <path
        android:fillColor="#FFA9CCFF"
        android:pathData="M37.35,41.9 H44.15 A0.85,0.85 0 0 1 45,42.75 A0.85,0.85 0 0 1 44.15,43.6 H37.35 A0.85,0.85 0 0 1 36.5,42.75 A0.85,0.85 0 0 1 37.35,41.9 Z" />
    <path
        android:fillColor="#FFA9CCFF"
        android:pathData="M37.35,46.3 H50.65 A0.85,0.85 0 0 1 51.5,47.15 A0.85,0.85 0 0 1 50.65,48 H37.35 A0.85,0.85 0 0 1 36.5,47.15 A0.85,0.85 0 0 1 37.35,46.3 Z" />

    <!-- 照片：白色相框（印刷照片的通用符号，与"图库"反复出现的满幅地平线构图无关） -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M50.3,50.5 H63.7 A7.8,7.8 0 0 1 71.5,58.3 V71.7 A7.8,7.8 0 0 1 63.7,79.5 H50.3 A7.8,7.8 0 0 1 42.5,71.7 V58.3 A7.8,7.8 0 0 1 50.3,50.5 Z" />

    <!-- 照片底（深蓝，明显深于背景渐变，保证与背景可分） -->
    <path
        android:fillColor="#FF0A3FA8"
        android:pathData="M50.3,52.5 H63.7 A5.8,5.8 0 0 1 69.5,58.3 V71.7 A5.8,5.8 0 0 1 63.7,77.5 H50.3 A5.8,5.8 0 0 1 44.5,71.7 V58.3 A5.8,5.8 0 0 1 50.3,52.5 Z" />

    <!-- 白卡纸 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M51.7,56.1 H62.3 A3.6,3.6 0 0 1 65.9,59.7 V70.3 A3.6,3.6 0 0 1 62.3,73.9 H51.7 A3.6,3.6 0 0 1 48.1,70.3 V59.7 A3.6,3.6 0 0 1 51.7,56.1 Z" />

