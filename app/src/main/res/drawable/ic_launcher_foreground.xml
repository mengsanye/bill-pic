        <path
            android:fillColor="#FF1E63D6"
            android:pathData="M56.7,72.6 L60.95,65 L64.6,72.6 Z" />
        <path
            android:fillColor="#FFFFC24B"
            android:pathData="M58.9,61.2 A1.748,1.748 0 1 0 62.4,61.2 A1.748,1.748 0 1 0 58.9,61.2 Z" />
    </group>

</vector>
