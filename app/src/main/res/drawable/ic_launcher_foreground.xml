<?xml version="1.0" encoding="utf-8"?>
<!--
  BillPic 自适应图标 · 前景层
  ─────────────────────────────────────────────────────────────
  概念：「一页发票，就是一张图」
    白色纸张 + 折角   → 这是一份 PDF 文档
    两条淡蓝文字条     → 文档原本的文字内容
    远山 / 近山 / 太阳 → 转换出来的图片

  几何（108dp 标准画布，视口单位 = dp）：
    纸张        37 × 52 dp，居中于 (54, 54)，圆角 3.4
    折角        11.5 dp（右上角沿对角线切开，纸片保留原圆角）
    安全区      66 dp 直径圆（半径 33）
    前景最远点  30.58 dp < 33 ✓
    最细特征    文字条高 1.7 dp（192px 下约 4.5px，48px 下约 1.1px）

  色彩令牌同源 ui/theme/Color.kt（品牌蓝 = #007AFF）：
    #FFFFFF 纸张 / #D8E7FF 折角 / #A9CCFF 文字条
    #6FB4FF 远山 / #007AFF 近山与太阳

  修改此文件后请同步更新 design/icon/generate_icons.py ——
  两者是同一套几何的矢量与位图两种表达，必须保持一致。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 折角纸片：位于被切掉的角上，纸张覆盖后交界处自然形成折线 -->
    <path
        android:fillColor="#D8E7FF"
        android:pathData="M61,28 L69.1,28 A3.4,3.4 0 0 1 72.5,31.4 L72.5,39.5 Z" />

    <!-- 纸张：圆角矩形，右上角沿对角线切掉 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38.9,28 L61,28 L72.5,39.5 L72.5,76.6 A3.4,3.4 0 0 1 69.1,80 L38.9,80 A3.4,3.4 0 0 1 35.5,76.6 L35.5,31.4 A3.4,3.4 0 0 1 38.9,28 Z" />

    <!-- 文字条（两端全圆角） -->
    <path
        android:fillColor="#A9CCFF"
        android:pathData="M40.35,34.6 H62.15 A0.85,0.85 0 0 1 62.15,36.3 H40.35 A0.85,0.85 0 0 1 40.35,34.6 Z" />
    <path
        android:fillColor="#A9CCFF"
        android:pathData="M40.35,39 H50.15 A0.85,0.85 0 0 1 50.15,40.7 H40.35 A0.85,0.85 0 0 1 40.35,39 Z" />

    <!-- 太阳 -->
    <path
        android:fillColor="#007AFF"
        android:pathData="M59.3,51.5 a3.7,3.7 0 1 0 7.4,0 a3.7,3.7 0 1 0 -7.4,0 Z" />

    <!-- 远山（浅）→ 近山（深）：近山压在上层形成前后关系 -->
    <path
        android:fillColor="#6FB4FF"
        android:pathData="M48.5,53 L39.5,74 H58.5 Z" />
    <path
        android:fillColor="#007AFF"
        android:pathData="M61.5,59.5 L53,74 H68.5 Z" />

</vector>
